---
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Search' },
  { href: '/suppliers', label: 'Suppliers' },
  { href: '/inventory', label: 'My parts' },
];
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/">PROJECT<span>dir</span></a>

    <nav aria-label="Main">
      <ul class="nav-list">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={isActive(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))
        }
        <li>
          <div class="themes" role="group" aria-label="Colour theme">
            <button type="button" data-theme-set="system" aria-pressed="false">Auto</button>
            <button type="button" data-theme-set="light" aria-pressed="false">Light</button>
            <button type="button" data-theme-set="dark" aria-pressed="false">Dark</button>
          </div>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 2px solid var(--pd-fg);
    background: var(--pd-bg);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 68px;
    gap: 16px;
    flex-wrap: wrap;
  }
  .brand {
    font: 700 1.3rem var(--pd-serif);
    color: var(--pd-fg);
    text-decoration: none;
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .brand span {
    color: var(--pd-accent);
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-list a {
    font: 500 0.88rem var(--pd-mono);
    color: var(--pd-fg);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    padding: 10px 12px;
    min-height: 44px;
    border-radius: 6px;
  }
  .nav-list a:hover {
    background: var(--pd-raised);
  }
  .nav-list a[aria-current='page'] {
    background: var(--pd-raised);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .themes {
    display: flex;
    gap: 2px;
    border: 1px solid var(--pd-border);
    border-radius: 999px;
    padding: 3px;
    background: var(--pd-surface);
  }
  .themes button {
    font: 500 0.75rem var(--pd-mono);
    color: var(--pd-fg-muted);
    background: none;
    border: 0;
    border-radius: 999px;
    padding: 6px 12px;
    min-height: 34px;
    cursor: pointer;
  }
  /*
    `:hover` must NOT override the pressed state. Same specificity, later rule,
    so an unguarded hover recolours the active pill with its own foreground and
    the label disappears (measured 1.00:1 in review — a WCAG 1.4.3 failure).
  */
  .themes button:hover:not([aria-pressed='true']) {
    color: var(--pd-fg);
  }
  .themes button[aria-pressed='true'] {
    background: var(--pd-fg);
    color: var(--pd-bg);
  }

  /* Reflow at 320px: without this the nav + theme group overflow to ~444px and
     force horizontal scrolling (WCAG 1.4.10). */
  @media (max-width: 560px) {
    .bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding-top: 12px;
      padding-bottom: 12px;
    }
    nav {
      width: 100%;
    }
    .nav-list {
      flex-wrap: wrap;
      gap: 2px;
    }
    .nav-list a {
      padding: 8px 10px;
      font-size: 0.84rem;
    }
    .themes {
      width: 100%;
      justify-content: space-between;
    }
    .themes button {
      flex: 1;
      min-height: 44px;
    }
  }
</style>

<script>
  // Mirrors Base.astro's pre-paint script, plus the toggle wiring.
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-set]');
  const apply = (t: string) => {
    document.documentElement.dataset.theme = t;
    try {
      localStorage.setItem('projectdir.theme', t);
    } catch {
      /* private mode — the theme still applies for this page view */
    }
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === t)));
  };

  let initial = 'system';
  try {
    initial = localStorage.getItem('projectdir.theme') || 'system';
  } catch {
    /* ignore */
  }
  buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeSet === initial)));

  buttons.forEach((b) => {
    b.addEventListener('click', () => apply(b.dataset.themeSet ?? 'system'));
  });
</script>