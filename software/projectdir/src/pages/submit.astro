---
import Base from '../layouts/Base.astro';
---

<Base title="Suggest a supplier — PROJECTdir">
  <div class="wrap">
    <h1>Suggest a supplier</h1>
    <p class="lede">
      Know an Indian supplier that is missing, or spotted something wrong in an existing
      listing? Add it below.
    </p>

    <form id="suggest" novalidate>
      <div class="field">
        <label for="name">Supplier name <span class="req" aria-hidden="true">*</span></label>
        <input id="name" name="name" type="text" required autocomplete="organization"
               aria-describedby="name-hint" />
        <p class="hint" id="name-hint">The trading name people would search for.</p>
      </div>

      <div class="field">
        <label for="url">Website <span class="req" aria-hidden="true">*</span></label>
        <input id="url" name="url" type="url" required inputmode="url" placeholder="https://"
               aria-describedby="url-hint" />
        <p class="hint" id="url-hint">
          Must be <code>https</code>. A shopfront, not a marketplace listing — suppliers
          who only sell through Amazon or Flipkart belong on their own page, not here.
        </p>
      </div>

      <div class="row">
        <div class="field">
          <label for="city">City <span class="req" aria-hidden="true">*</span></label>
          <input id="city" name="city" type="text" required autocomplete="address-level2" />
        </div>
        <div class="field">
          <label for="state">State</label>
          <input id="state" name="state" type="text" autocomplete="address-level1" />
        </div>
      </div>

      <div class="field">
        <label for="categories">Categories stocked</label>
        <textarea id="categories" name="categories" rows="3"
                  aria-describedby="cat-hint"
                  placeholder="servos, gearmotors, bearings"></textarea>
        <p class="hint" id="cat-hint">
          Comma-separated. Use the ids from <a href="/suppliers">the supplier list</a>.
        </p>
      </div>

      <div class="field">
        <label for="blurb">One honest sentence</label>
        <textarea id="blurb" name="blurb" rows="2" maxlength="160"
                  aria-describedby="blurb-hint"></textarea>
        <p class="hint" id="blurb-hint">What they are known for. No marketing.</p>
      </div>

      <label class="check" for="panIndia">
        <input type="checkbox" id="panIndia" name="panIndia" checked />
        Ships across India
      </label>

      <p class="status" id="status" role="status" aria-live="polite"></p>
      <button type="submit" class="btn">Submit suggestion</button>
    </form>

    <div class="alt">
      <h2>Prefer a pull request?</h2>
      <p>
        Each listing is one entry in <code>src/data/vendors.json</code>. Editing the file
        directly means your correction lands immediately and is attributable to you.
      </p>
    </div>
  </div>
</Base>

<style>
  .wrap { max-width: 640px; padding-top: 40px; padding-bottom: 40px; }
  h1 { font: 700 clamp(1.8rem,4.5vw,2.5rem)/1.1 var(--pd-serif); margin: 0 0 12px; letter-spacing: -0.015em; }
  .lede { color: var(--pd-fg-muted); margin: 0 0 28px; max-width: 56ch; }
  .field { margin-bottom: 18px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; } }
  label { display: block; font: 600 0.78rem var(--pd-mono); text-transform: uppercase;
          letter-spacing: 0.08em; margin-bottom: 7px; color: var(--pd-fg-muted); }
  .req { color: var(--pd-accent); }
  input[type=text], input[type=url], textarea {
    width: 100%; min-height: 46px; font: inherit; padding: 11px 13px;
    border: 1px solid var(--pd-border); border-radius: 8px;
    background: var(--pd-surface); color: var(--pd-fg);
  }
  textarea { min-height: 74px; resize: vertical; }
  .hint { font-size: 0.84rem; color: var(--pd-fg-muted); margin: 6px 0 0; }
  .hint a { color: var(--pd-accent); }
  code { font: 0.9em var(--pd-mono); background: var(--pd-raised); padding: 1px 5px; border-radius: 3px; color: var(--pd-fg); }
  .check { display: flex; align-items: center; gap: 10px; min-height: 44px;
           text-transform: none; letter-spacing: 0; font: inherit; font-size: 0.95rem;
           color: var(--pd-fg); cursor: pointer; }
  .check input { width: 20px; height: 20px; accent-color: var(--pd-accent); }
  .btn { margin-top: 8px; min-height: 48px; padding: 12px 22px; border: 1px solid var(--pd-fg);
         border-radius: 8px; background: var(--pd-fg); color: var(--pd-bg);
         font: 600 0.95rem var(--pd-sans); cursor: pointer; }
  .btn:hover { background: var(--pd-raised); color: var(--pd-fg); }
  .status { font: 0.88rem var(--pd-mono); margin: 14px 0 0; min-height: 1.3em; }
  .status.error { color: var(--pd-warn); }
  .alt { margin-top: 36px; border-top: 1px solid var(--pd-hairline); padding-top: 24px; }
  .alt h2 { font: 700 1.2rem var(--pd-serif); margin: 0 0 8px; }
  .alt p { color: var(--pd-fg-muted); max-width: 58ch; }
</style>

<script>
  // Phase 7 wires this to a real endpoint. Until then it validates locally and
  // says plainly that nothing was sent, rather than pretending to have submitted.
  const form = document.getElementById('suggest') as HTMLFormElement;
  const status = document.getElementById('status') as HTMLParagraphElement;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    status.classList.remove('error');

    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    const url = (form.elements.namedItem('url') as HTMLInputElement).value.trim();
    const city = (form.elements.namedItem('city') as HTMLInputElement).value.trim();

    const problems: string[] = [];
    if (!name) problems.push('a supplier name');
    if (!city) problems.push('a city');
    if (!/^https:\/\//i.test(url)) problems.push('an https website URL');

    if (problems.length) {
      status.classList.add('error');
      status.textContent = `Still needed: ${problems.join(', ')}.`;
      const first = form.querySelector<HTMLElement>(':invalid, input, textarea');
      first?.focus();
      return;
    }

    status.textContent =
      'Validated — but the submission endpoint is not connected yet. Open a pull request against src/data/vendors.json in the meantime.';
  });
</script>