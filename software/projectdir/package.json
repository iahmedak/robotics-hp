{
  "name": "projectdir",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Community-maintained directory of Indian suppliers for robotics parts.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "tsc --noEmit",
    "check:astro": "astro check",
    "check:worker": "npm --prefix workers/live run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "validate": "npm run check && npm run check:astro && npm run check:worker && npm run test && npm run build && npm run check:bundle && npm run test:browser"
  },
  "dependencies": {
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7",
    "vitest": "2.1"
  }
}
