# ============================================================
# VIC Discord Bot — environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`. NEVER paste these values into chat.
# ============================================================

# ---- Discord ----
# Bot token from https://discord.com/developers/applications
#   -> Your Application -> Bot -> Reset Token
# Full value includes the "Bot " prefix is NOT required; the raw
# token from the portal is what goes here.
DISCORD_TOKEN=PASTE_DISCORD_BOT_TOKEN_HERE

# Public application id (safe, appears in invite URLs)
DISCORD_CLIENT_ID=1559666838768459776

# Target guild. Enable Developer Mode in Discord (User Settings ->
# Advanced), then right-click your server name -> Copy Server ID.
DISCORD_GUILD_ID=PASTE_SERVER_ID_HERE

# ---- Supabase ----
SUPABASE_URL=https://xfxowxclixfpkqgqaeyw.supabase.co

# Service role key: Supabase Dashboard -> Project Settings ->
#   API -> service_role  (click "Reveal"). This key BYPASSES RLS.
# Server-side only. Rotating it invalidates any copy in the wild.
SUPABASE_SERVICE_ROLE_KEY=PASTE_SUPABASE_SERVICE_ROLE_KEY_HERE

# ---- Role names (provision script creates these and writes IDs) ----
ROLE_FOUNDER=⚡ Founder
ROLE_ADMIN=🛡️ Admin
ROLE_MODERATOR=🧭 Moderator
ROLE_MENTOR=🎓 Mentor
ROLE_APPLICANT=⏳ Applicant
ROLE_MEMBER=✅ Member
ROLE_BOT=🤖 VIC Bot

# ---- Charter offices (established by the founding members 2026-10-15) ----
# Left blank so config.js falls back to its documented default. Set these only
# to pin an existing role id created out-of-band.
# There is deliberately NO ROLE_OOA_DIRECTOR: Operations Director also leads the
# Operations and Administration division (spec §3.1).
ROLE_EXECUTIVE_DIRECTOR=🎖️ Executive Director
ROLE_OPERATIONS_DIRECTOR=⚙️ Director of Operations
ROLE_ERS_DIRECTOR=📋 ERS Director
ROLE_CIS_DIRECTOR=💻 CIS Director
ROLE_EWO_DIRECTOR=📣 EWO Director

# ---- Division roles, mapped from Supabase divisions.id ----
# Format: <supabase_division_id>=<role_name>
# OAD was renamed to OOA. The division *id* VIC-DIV-004 is a contract with the
# public site and must never change; only the display name does.
DIVISION_ROLES=VIC-DIV-001=⚙️ ERS,VIC-DIV-002=💻 CIS,VIC-DIV-003=📣 EWO,VIC-DIV-004=📋 OOA (Ops & Admin)

# ---- Runtime ----
# Minutes between Supabase polls for new applications
POLL_INTERVAL_MINUTES=2
# Max approve/deny actions a single Discord user may take per window
RATE_LIMIT_ACTIONS=5
RATE_LIMIT_WINDOW_MINUTES=5